<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<!--
  De OWL-template. Dit is QWeb: HTML met extra t-attributen.

  - t-if / t-else      : toon dit stuk alleen onder een voorwaarde
  - t-foreach / t-as   : loop over een lijst (t-key is verplicht)
  - t-esc / t-out      : druk een waarde af
  - t-on-click         : koppel een klik aan een methode van de component
  - t-att-...          : bereken een HTML-attribuut
  - t-model            : twee richtingen: veld <-> state (zoals v-model)

  Alles wat je hier uit `state` haalt, wordt automatisch hertekend zodra die
  state verandert. Je hoeft nergens handmatig HTML te vervangen.
-->
<t t-name="event_builder.EventBuilder">
    <div class="o_event_builder" t-ref="root"
         t-att-class="{ 'o_has_mobile_bar': showMobileBar }">

        <div t-if="state.loading" class="text-center py-5">
            <span class="spinner-border" role="status"/>
        </div>

        <div t-elif="!state.config" class="alert alert-warning">
            Geen configurator gekoppeld aan dit blok.
        </div>

        <div t-else="" class="row g-4">

            <!-- ============ LINKS: de bouwblokken ============ -->
            <div class="col-lg-8">

                <!-- Stap 0: wanneer en waar. Bewust bovenaan, want de duur
                     bepaalt mee de prijs van huurmateriaal. -->
                <div class="card mb-4">
                    <div class="card-body">
                        <h4 class="card-title mb-3">Wanneer en met hoeveel?</h4>
                        <!-- Drie velden op één rij. De postcode is hier weg:
                             die halen we uit het leveradres, waar hij hoort en
                             waar hij ook echt het adres van de locatie is. -->
                        <div class="row g-3">
                            <div class="col-sm-4">
                                <label class="form-label" for="eb_date_from">Leverdatum</label>
                                <input id="eb_date_from" type="date" class="form-control"
                                       t-att-min="minDate"
                                       t-model="state.dateFrom"
                                       t-on-change="onDateChange"/>
                            </div>
                            <div class="col-sm-4">
                                <label class="form-label" for="eb_date_to">Ophaaldatum</label>
                                <input id="eb_date_to" type="date" class="form-control"
                                       t-att-min="state.dateFrom"
                                       t-model="state.dateTo"
                                       t-on-change="onDateChange"/>
                            </div>
                            <div class="col-sm-4">
                                <label class="form-label" for="eb_guests">
                                    <t t-esc="state.config.guest.label"/>
                                </label>
                                <input id="eb_guests" type="number" class="form-control"
                                       t-att-min="state.config.guest.min"
                                       t-att-max="state.config.guest.max"
                                       t-att-value="state.guestCount"
                                       t-on-change="onGuestCountChange"/>
                            </div>
                        </div>
                    </div>
                </div>

                <!--
                  Stapnavigatie. Blijft bovenaan plakken tijdens het scrollen,
                  zodat de bezoeker altijd ziet hoeveel stappen er zijn, welke
                  hij al ingevuld heeft, en rechtstreeks kan springen.
                -->
                <nav class="o_event_builder_nav d-flex flex-wrap gap-2 mb-4"
                     aria-label="Stappen">
                    <button t-foreach="state.config.steps" t-as="step" t-key="step.id"
                            type="button"
                            class="btn btn-sm rounded-pill"
                            t-att-class="isStepComplete(step) ? 'btn-primary' : 'btn-outline-secondary'"
                            t-on-click="() => this.goToStep(step.id)">
                        <span t-if="isStepComplete(step)" class="fa fa-check me-1"/>
                        <t t-esc="step.name"/>
                    </button>
                </nav>

                <!--
                  De stappen uit het ERP. Voegt een beheerder daar een optie
                  toe, dan staat ze na een refresh gewoon hier.

                  Elke stap is een horizontaal schuivende strip in plaats van
                  een raster. Zo blijft de pagina even lang bij 4 opties als
                  bij 40: de hoogte volgt het aantal STAPPEN, niet het aantal
                  producten. Zijwaarts scrollen binnen één categorie is ook de
                  natuurlijke beweging om te vergelijken.
                -->
                <section t-foreach="state.config.steps" t-as="step" t-key="step.id"
                         class="mb-4" t-att-data-step="step.id">
                    <div class="d-flex align-items-end justify-content-between mb-2">
                        <div>
                            <h4 class="mb-0"><t t-esc="step.name"/>
                                <span t-if="step.is_required" class="text-danger">*</span>
                            </h4>
                            <p t-if="step.description" class="text-muted small mb-0">
                                <t t-esc="step.description"/>
                            </p>
                        </div>
                        <!-- Pijlen alleen tonen als er echt iets te schuiven
                             valt, en enkel op grotere schermen: op een gsm
                             veeg je gewoon. -->
                        <div t-if="step.options.length > 2"
                             class="btn-group btn-group-sm d-none d-md-flex flex-shrink-0 ms-3">
                            <button type="button" class="btn btn-outline-secondary"
                                    t-att-aria-label="'Vorige ' + step.name"
                                    t-on-click="() => this.scrollStrip(step.id, -1)">
                                <span class="fa fa-chevron-left"/>
                            </button>
                            <button type="button" class="btn btn-outline-secondary"
                                    t-att-aria-label="'Volgende ' + step.name"
                                    t-on-click="() => this.scrollStrip(step.id, 1)">
                                <span class="fa fa-chevron-right"/>
                            </button>
                        </div>
                    </div>

                    <div class="o_event_builder_strip" t-att-data-strip="step.id">
                        <!-- Een <button> en geen <div>: zo werkt de
                             configurator ook met het toetsenbord en met een
                             schermlezer. -->
                        <button t-foreach="step.options" t-as="option" t-key="option.id"
                                type="button"
                                class="card o_event_builder_option text-start"
                                t-att-class="{ 'o_selected': isSelected(option.id) }"
                                t-att-aria-pressed="isSelected(option.id) ? 'true' : 'false'"
                                t-on-click="() => this.toggleOption(step, option.id)">
                            <span class="o_event_builder_check" t-if="isSelected(option.id)">
                                <span class="fa fa-check"/>
                            </span>
                            <img class="card-img-top o_event_builder_img"
                                 t-att-src="option.image_url" t-att-alt="option.name"
                                 loading="lazy"/>
                            <span class="card-body">
                                <span class="d-block fw-semibold"><t t-esc="option.name"/></span>
                                <span t-if="option.description"
                                      class="d-block small text-muted o_event_builder_desc">
                                    <t t-esc="option.description"/>
                                </span>
                                <span class="d-block mt-2 small">
                                    <span class="fw-bold" t-esc="formatPrice(option.unit_price)"/>
                                    <span class="text-muted"> <t t-esc="option.price_label"/></span>
                                </span>
                            </span>
                        </button>
                    </div>
                </section>
            </div>

            <!-- ============ RECHTS: de prijs, altijd zichtbaar ============ -->
            <div class="col-lg-4" data-summary="1">
                <div class="card o_event_builder_summary">
                    <div class="card-body">
                        <h4 class="card-title">Jouw event</h4>

                        <div t-if="state.error" class="alert alert-danger py-2 small">
                            <t t-esc="state.error"/>
                        </div>

                        <div t-if="!state.quote || !state.quote.lines.length"
                             class="text-muted small py-3">
                            Maak hiernaast een keuze om je prijs te zien.
                        </div>

                        <div t-else="">
                            <div class="small text-muted mb-2">
                                <t t-esc="state.guestCount"/> personen &#183;
                                <t t-esc="durationDays"/> dag(en)
                            </div>
                            <table class="table table-sm">
                                <tbody>
                                    <tr t-foreach="state.quote.lines" t-as="line" t-key="line.option_id">
                                        <td class="ps-0">
                                            <t t-esc="line.name"/>
                                            <div class="text-muted small">
                                                <t t-esc="line.product_uom_qty"/> x
                                                <t t-esc="formatPrice(line.price_unit)"/>
                                            </div>
                                        </td>
                                        <td class="text-end pe-0">
                                            <t t-esc="formatPrice(line.price_subtotal)"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <div class="d-flex justify-content-between small text-muted">
                                <span>Excl. btw</span>
                                <span t-esc="formatPrice(state.quote.amount_untaxed)"/>
                            </div>
                            <div class="d-flex justify-content-between small text-muted">
                                <span>Btw</span>
                                <span t-esc="formatPrice(state.quote.amount_tax)"/>
                            </div>
                            <hr/>
                            <div class="d-flex justify-content-between fs-4 fw-bold">
                                <span>Totaal</span>
                                <span t-att-class="{ 'opacity-50': state.pricing }"
                                      t-esc="formatPrice(state.quote.amount_total)"/>
                            </div>

                            <!-- Het voorschot. Alleen tonen wanneer het echt
                                 een deelbetaling is: bij 100% zou "nu te
                                 betalen" gelijk zijn aan het totaal en de
                                 klant enkel verwarren. -->
                            <div t-if="hasPrepayment"
                                 class="d-flex justify-content-between mt-2 pt-2 border-top">
                                <span class="fw-semibold">
                                    Nu te betalen
                                    <span class="text-muted fw-normal">
                                        (<t t-esc="prepaymentPercent"/>%)
                                    </span>
                                </span>
                                <span class="fw-semibold" t-esc="formatPrice(prepaymentAmount)"/>
                            </div>
                            <div t-if="hasPrepayment" class="text-muted small">
                                Rest na afloop van je event.
                            </div>
                        </div>

                        <div t-if="missingSteps.length" class="alert alert-info py-2 small mt-3 mb-0">
                            Nog te kiezen:
                            <t t-foreach="missingSteps" t-as="step" t-key="step.id">
                                <t t-esc="step.name"/><t t-if="!step_last">, </t>
                            </t>
                        </div>

                        <!-- ===== Adressen: enkel voor ingelogde klanten ===== -->
                        <div t-if="state.isLoggedIn and state.addresses and state.quote and state.quote.lines.length"
                             class="mt-3">
                            <hr/>

                            <!-- Leveradres. Samengevouwen: één regel. -->
                            <t t-call="event_builder.AddressRow">
                                <t t-set="type" t-value="'delivery'"/>
                                <t t-set="label" t-value="'Leveren naar'"/>
                                <t t-set="addr" t-value="address('delivery')"/>
                            </t>

                            <!-- Factuuradres. Verbergen zolang het vinkje
                                 aanstaat: dan is er niets te kiezen. -->
                            <div class="form-check small mt-2 mb-1">
                                <input class="form-check-input" type="checkbox" id="eb_same_addr"
                                       t-model="state.useDeliveryAsBilling"/>
                                <label class="form-check-label" for="eb_same_addr">
                                    Factuuradres is hetzelfde
                                </label>
                            </div>
                            <t t-if="!state.useDeliveryAsBilling">
                                <t t-call="event_builder.AddressRow">
                                    <t t-set="type" t-value="'invoice'"/>
                                    <t t-set="label" t-value="'Factuur naar'"/>
                                    <t t-set="addr" t-value="address('invoice')"/>
                                </t>
                            </t>
                        </div>

                        <!-- De knop is nooit een dode grijze knop: hij zegt wat
                             de volgende stap is en brengt je er ook naartoe. -->
                        <button class="btn btn-primary w-100 mt-3"
                                t-att-disabled="state.submitting or !hasValidSelection"
                                t-on-click="onPrimaryAction">
                            <span t-if="state.submitting" class="spinner-border spinner-border-sm me-1"/>
                            <span t-if="!state.isLoggedIn" class="fa fa-sign-in me-1"/>
                            <t t-esc="submitLabel"/>
                        </button>

                        <div t-if="!state.isLoggedIn" class="text-muted small text-center mt-2">
                            Je keuze blijft bewaard terwijl je inlogt.
                        </div>
                        <div t-elif="isAddressDirty" class="text-primary small text-center mt-2">
                            Je hebt je adres aangepast maar nog niet bewaard.
                        </div>
                        <div t-elif="incompleteAddresses.length" class="text-muted small text-center mt-2">
                            Nog aan te vullen:
                            <t t-esc="incompleteAddresses.join(' en ')"/>
                        </div>
                        <div t-else="" class="text-muted small text-center mt-2">
                            Je krijgt eerst je offerte te zien - je betaalt pas daarna.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!--
          ============ MOBIEL: vaste balk onderaan ============
          Op een gsm staat het prijspaneel onder alle stappen, dus zonder deze
          balk zou de bezoeker eerst voorbij alles moeten scrollen om zijn
          totaal te zien - net op het toestel waar mensen 's avonds rondkijken.

          De knop stuurt naar het paneel in plaats van meteen te bestellen:
          daar staan de contactgegevens die nog ingevuld moeten worden. Een
          knop die soms bestelt en soms niet, is verwarrender dan een knop die
          altijd hetzelfde doet.
        -->
        <div t-if="showMobileBar" class="o_event_builder_mobile_bar d-lg-none">
            <div class="d-flex align-items-center justify-content-between gap-3">
                <div class="lh-sm">
                    <div class="fw-bold" t-esc="formatPrice(state.quote.amount_total)"/>
                    <div t-if="hasPrepayment" class="small text-muted">
                        nu <t t-esc="formatPrice(prepaymentAmount)"/>
                        (<t t-esc="prepaymentPercent"/>%)
                    </div>
                    <div t-else="" class="small text-muted">
                        <t t-esc="state.guestCount"/> personen
                    </div>
                </div>
                <button class="btn btn-primary flex-shrink-0" t-on-click="goToSummary">
                    Bekijk &amp; boek
                </button>
            </div>
        </div>
    </div>
</t>

<!--
  Eén adresregel: samengevouwen tekst, uitgeklapt een formulier.

  Deze template wordt met t-call twee keer gebruikt, voor het lever- en het
  factuuradres. De aanroeper zet `type`, `label` en `addr` met t-set; binnen
  de template zijn dat gewone variabelen.
-->
<t t-name="event_builder.AddressRow">
    <div class="border rounded p-2 mb-2"
         t-att-class="{
             'border-warning': addr and !addr.is_complete,
             'border-primary': state.expandedAddress === type and isAddressDirty,
         }">

        <div class="d-flex justify-content-between align-items-start">
            <div class="flex-grow-1 me-2">
                <div class="text-muted small"><t t-esc="label"/></div>
                <div class="small" t-if="addr and addr.display">
                    <t t-esc="addr.display"/>
                </div>
                <div class="small text-muted fst-italic" t-else="">
                    Nog geen adres
                </div>
            </div>
            <button class="btn btn-link btn-sm p-0 text-decoration-none flex-shrink-0"
                    t-att-aria-expanded="state.expandedAddress === type ? 'true' : 'false'"
                    t-on-click="() => this.toggleAddress(type)">
                <span t-if="state.expandedAddress === type" class="fa fa-chevron-up"/>
                <span t-else="" class="fa fa-pencil"/>
            </button>
        </div>

        <div t-if="addr and !addr.is_complete and state.expandedAddress !== type"
             class="small text-warning mt-1">
            Nog aan te vullen
        </div>

        <!-- ===== Uitgeklapt: het formulier ===== -->
        <div t-if="state.expandedAddress === type and state.addressDraft" class="mt-2 pt-2 border-top">

            <!-- De selectie bepalen we met een methode op de component en niet
                 met een uitdrukking in de template. OWL laat in templates maar
                 een korte lijst globals toe (zie RESERVED_WORDS in owl.js);
                 String() hoort daar niet bij en laat de render stilletjes
                 crashen. -->
            <select class="form-select form-select-sm mb-2" t-on-change="onAddressChoice">
                <option t-foreach="state.addresses.choices" t-as="choice" t-key="choice.id"
                        t-att-value="choice.id"
                        t-att-selected="isCurrentChoice(choice.id)">
                    <t t-esc="choice.label"/>
                </option>
                <option value="new" t-att-selected="!state.addressDraft.partner_id">
                    Nieuw adres...
                </option>
            </select>

            <!-- Een sterretje op de verplichte velden. Welke dat zijn, komt
                 van de server en hangt af van het land. -->
            <input type="text" class="form-control form-control-sm mb-2"
                   t-att-placeholder="fieldLabel('name', 'Naam')"
                   t-att-class="{ 'is-invalid': isMissingField('name') }"
                   t-model="state.addressDraft.name"/>
            <input type="text" class="form-control form-control-sm mb-2"
                   t-att-placeholder="fieldLabel('street', 'Straat en nummer')"
                   t-att-class="{ 'is-invalid': isMissingField('street') }"
                   t-model="state.addressDraft.street"/>
            <div class="row g-2 mb-2">
                <div class="col-4">
                    <input type="text" class="form-control form-control-sm"
                           t-att-placeholder="fieldLabel('zip', 'Postcode')"
                           t-att-class="{ 'is-invalid': isMissingField('zip') }"
                           t-model="state.addressDraft.zip"/>
                </div>
                <div class="col-8">
                    <input type="text" class="form-control form-control-sm"
                           t-att-placeholder="fieldLabel('city', 'Gemeente')"
                           t-att-class="{ 'is-invalid': isMissingField('city') }"
                           t-model="state.addressDraft.city"/>
                </div>
            </div>
            <select class="form-select form-select-sm mb-2" t-on-change="onCountryChange">
                <option value="">Land...</option>
                <option t-foreach="countries" t-as="country" t-key="country.id"
                        t-att-value="country.id"
                        t-att-selected="isCurrentCountry(country.id)">
                    <t t-esc="country.name"/>
                </option>
            </select>
            <div t-if="state.countriesLoading" class="text-muted small mb-2">Landen laden...</div>
            <select t-if="draftStates.length" class="form-select form-select-sm mb-2"
                    t-model="state.addressDraft.state_id">
                <option value="">Provincie...</option>
                <option t-foreach="draftStates" t-as="st" t-key="st.id" t-att-value="st.id">
                    <t t-esc="st.name"/>
                </option>
            </select>
            <input type="tel" class="form-control form-control-sm mb-2"
                   t-att-placeholder="fieldLabel('phone', 'Telefoon')"
                   t-att-class="{ 'is-invalid': isMissingField('phone') }"
                   t-model="state.addressDraft.phone"/>
            <input type="email" class="form-control form-control-sm mb-2"
                   t-att-placeholder="fieldLabel('email', 'E-mail')"
                   t-att-class="{ 'is-invalid': isMissingField('email') }"
                   t-model="state.addressDraft.email"/>

            <div t-if="state.addressError" class="alert alert-danger py-1 px-2 small">
                <t t-esc="state.addressError"/>
            </div>

            <!-- Zolang er iets gewijzigd is, valt de Bewaren-knop op en staat
                 er expliciet bij dat het nog niet opgeslagen is. Boeken is
                 tot zolang geblokkeerd. -->
            <div t-if="isAddressDirty" class="small text-primary mb-2">
                <span class="fa fa-pencil me-1"/>Nog niet opgeslagen
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-sm flex-grow-1"
                        t-att-class="isAddressDirty ? 'btn-primary' : 'btn-outline-primary'"
                        t-att-disabled="state.addressSaving"
                        t-on-click="saveAddress">
                    <span t-if="state.addressSaving" class="spinner-border spinner-border-sm me-1"/>
                    Bewaren
                </button>
                <button class="btn btn-sm btn-link text-muted text-decoration-none"
                        t-att-disabled="state.addressSaving"
                        t-on-click="cancelAddressEdit">
                    Annuleren
                </button>
            </div>
        </div>
    </div>
</t>

</templates>
